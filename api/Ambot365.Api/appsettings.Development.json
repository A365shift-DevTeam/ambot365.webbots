{
  // ---------------------------------------------------------------------------
  // LOCAL DEVELOPMENT settings. Loaded on top of appsettings.json only when
  // ASPNETCORE_ENVIRONMENT=Development, which `dotnet run` sets automatically.
  //
  // This file is excluded from `dotnet publish`, so it can never reach the
  // server. Every production value in appsettings.json is deliberately
  // overridden here — leaving one out would silently point local development at
  // the production database.
  // ---------------------------------------------------------------------------

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=demosites;Username=postgres;Password=postgres"
  },

  "Admin": {
    "Password": "admin123",
    "JwtSecret": "dev-only-signing-key-not-used-in-production-0123456789abcdef"
  },

  // `npm run dev` proxies /api and /uploads to this API, so the browser stays on
  // one origin and CORS never applies. This entry only matters if you point the
  // SPA at the API directly (VITE_API_BASE_URL=http://localhost:5201).
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  }
}
