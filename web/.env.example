# Template. Vite loads .env.development for `npm run dev` and .env.production
# for `npm run build`; both are committed because neither contains a secret.
# Only VITE_-prefixed variables reach the browser bundle.

# Absolute origin of the .NET API. Leave empty to use the page's own origin
# (correct in development, where Vite proxies /api and /uploads).
VITE_API_BASE_URL=https://demoapi.ambot365.com

# Development only: proxy target for /api and /uploads.
VITE_DEV_API_ORIGIN=http://localhost:5201
