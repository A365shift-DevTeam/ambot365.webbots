# Development: `npm run dev` proxies /api and /uploads to the .NET API (see
# vite.config.ts), so the browser stays on http://localhost:5173 for everything
# and no CORS is involved. An empty base URL means "same origin as this page",
# which is exactly what the proxy provides.
VITE_API_BASE_URL=

# Where the dev server proxies /api and /uploads to. Match the API's launch
# profile in api/Ambot365.Api/Properties/launchSettings.json.
VITE_DEV_API_ORIGIN=http://localhost:5201
