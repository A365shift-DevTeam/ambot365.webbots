# AMBOT 365 — copy to .env.local and fill in.
# Every value below has an insecure or surprising fallback if omitted, so set
# all of them even for local development.

# --- Catalog API (.NET) -----------------------------------------------------
# AMBOT_API_KEY must match Api:Key in api/Ambot365.Api/appsettings.Development.json.
# No NEXT_PUBLIC_ prefix: src/lib/api.ts is server-only and this must not reach
# the browser.
AMBOT_API_URL=http://localhost:5201
AMBOT_API_KEY=

# --- Admin auth -------------------------------------------------------------
# Without these, src/lib/auth.ts signs sessions with 'fallback-secret-change-me'
# and /admin/login accepts 'admin123'.
JWT_SECRET=
ADMIN_PASSWORD=

# --- Supabase Storage (image uploads only) ----------------------------------
# The .NET API replaced Supabase as the database, not as the file store.
# Without these, src/app/api/upload/route.ts writes to public/uploads on local
# disk instead — which does not survive a serverless deploy.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
